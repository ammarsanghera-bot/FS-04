# Local development only. Replace every secret before any shared or production deployment.

NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
DATABASE_URL=postgresql://flowboard:flowboard@localhost:5432/flowboard
TEST_DATABASE_URL=postgresql://flowboard:flowboard@localhost:5432/flowboard_test

# Generate long random strings. These values are local placeholders.
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-please-32b
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-please-32
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14
BCRYPT_ROUNDS=12

UPLOAD_DIR=uploads
STORAGE_DRIVER=local
MAX_UPLOAD_BYTES=10485760

# Optional S3-compatible storage. Leave blank to keep local disk storage.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Mailpit in Docker Compose: SMTP_HOST=mailpit SMTP_PORT=1025
SMTP_HOST=
SMTP_PORT=1025
SMTP_FROM=Flowboard <noreply@flowboard.local>

# inprocess works without Redis. Set bullmq when Redis is available.
JOBS_DRIVER=inprocess
REDIS_URL=redis://localhost:6379
JOB_INTERVAL_MS=60000

# Leave Stripe blank to run billing in labeled demo mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

VITE_API_URL=http://localhost:4000
